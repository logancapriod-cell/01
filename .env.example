# VIRALLAB_LLM_KEY=
# VIRALLAB_LLM_BASE_URL=https://api.openai.com/v1
# VIRALLAB_LLM_MODEL=gpt-4o-mini
# VIRALLAB_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# VIRALLAB_DATA_DIR=/workspace/01/data
# PORT=8000
